#!/bin/sh
set -eu

socket="${AICAGE_SSH_AUTH_SOCK:-/run/aicage-credential-agent/ssh-agent.sock}"
error_file="${AICAGE_SSH_LOAD_ERROR_FILE:-/tmp/aicage-credential-agent/ssh-load-error}"

case "${1:-}" in
  serve)
    rm -f "$socket"
    exec ssh-agent -D -a "$socket"
    ;;
  ready)
    if SSH_AUTH_SOCK="$socket" ssh-add -l >/dev/null 2>&1; then
      exit 0
    else
      [ "$?" -eq 1 ]
    fi
    ;;
  load)
    key_path="${2:?Usage: aicage-credential-agent ssh load KEY_PATH}"
    mkdir -p "$(dirname "$error_file")"
    rm -f "$error_file"
    key_copy="$(mktemp)"
    trap 'rm -f "$key_copy"' EXIT HUP INT TERM
    if ! cp "$key_path" "$key_copy" >"$error_file" 2>&1; then
      cat "$error_file" >&2
      exit 1
    fi
    chmod 600 "$key_copy"
    if SSH_AUTH_SOCK="$socket" \
      SSH_ASKPASS=/usr/local/libexec/aicage-credential-agent/ssh-askpass \
      SSH_ASKPASS_REQUIRE=force \
      DISPLAY=aicage \
      ssh-add "$key_copy" >"$error_file" 2>&1; then
      rm -f "$error_file"
    else
      cat "$error_file" >&2
      exit 1
    fi
    ;;
  last-error)
    test -f "$error_file" && cat "$error_file" || true
    ;;
  *)
    echo "Usage: aicage-credential-agent ssh {last-error|load KEY_PATH|ready|serve}" >&2
    exit 64
    ;;
esac
