#!/bin/sh
set -eu

socket="${SSH_AUTH_SOCK:-/run/credential-agent/ssh-agent.sock}"

case "${1:-}" in
  serve)
    rm -f "$socket"
    exec ssh-agent -D -a "$socket"
    ;;
  ready)
    if SSH_AUTH_SOCK="$socket" ssh-add -l >/dev/null 2>&1; then
      exit 0
    else
      [ "$?" -eq 1 ]
    fi
    ;;
  list)
    if identities="$(SSH_AUTH_SOCK="$socket" ssh-add -L)"; then
      printf '%s\n' "$identities"
    else
      [ "$?" -eq 1 ]
    fi
    ;;
  fingerprint)
    key_path="${2:?Usage: credential-agent ssh fingerprint KEY_PATH}"
    ssh-keygen -lf "$key_path" -E sha256 | awk 'NR == 1 {print $2}'
    ;;
  identity-fingerprint)
    identity="${2:?Usage: credential-agent ssh identity-fingerprint PUBLIC_KEY}"
    printf '%s\n' "$identity" | ssh-keygen -lf - -E sha256 | awk 'NR == 1 {print $2}'
    ;;
  encrypted)
    key_path="${2:?Usage: credential-agent ssh encrypted KEY_PATH}"
    if ssh-keygen -y -P '' -f "$key_path" >/dev/null 2>&1; then
      printf '%s\n' unencrypted
    else
      printf '%s\n' encrypted
    fi
    ;;
  load)
    key_path="${2:?Usage: credential-agent ssh load KEY_PATH}"
    key_copy="${3:?Usage: credential-agent ssh load KEY_PATH COPY_PATH}"
    umask 077
    mkdir -p "$(dirname "$key_copy")"
    chmod 700 "$(dirname "$key_copy")"
    certificate_copy="${key_copy}-cert.pub"
    trap 'rm -f "$key_copy" "$certificate_copy"' EXIT HUP INT TERM
    cp "$key_path" "$key_copy"
    chmod 600 "$key_copy"
    if [ -f "${key_path}-cert.pub" ]; then
      cp "${key_path}-cert.pub" "$certificate_copy"
    fi
    SSH_AUTH_SOCK="$socket" \
      SSH_ASKPASS=/usr/local/libexec/credential-agent/ssh-askpass \
      SSH_ASKPASS_REQUIRE=force \
      DISPLAY=dummy \
      ssh-add "$key_copy"
    ;;
  load-interactive)
    key_path="${2:?Usage: credential-agent ssh load-interactive KEY_PATH}"
    key_copy="${3:?Usage: credential-agent ssh load-interactive KEY_PATH COPY_PATH}"
    umask 077
    mkdir -p "$(dirname "$key_copy")"
    chmod 700 "$(dirname "$key_copy")"
    certificate_copy="${key_copy}-cert.pub"
    trap 'rm -f "$key_copy" "$certificate_copy"' EXIT HUP INT TERM
    cp "$key_path" "$key_copy"
    chmod 600 "$key_copy"
    if [ -f "${key_path}-cert.pub" ]; then
      cp "${key_path}-cert.pub" "$certificate_copy"
    fi
    SSH_AUTH_SOCK="$socket" ssh-add "$key_copy"
    ;;
  remove)
    key_copy="$(mktemp)"
    trap 'rm -f "$key_copy"' EXIT HUP INT TERM
    IFS= read -r public_key
    test -n "$public_key"
    printf '%s\n' "$public_key" > "$key_copy"
    SSH_AUTH_SOCK="$socket" ssh-add -d "$key_copy"
    ;;
  *)
    echo "Usage: credential-agent ssh {encrypted|fingerprint|identity-fingerprint|list|load KEY_PATH|load-interactive KEY_PATH|remove|ready|serve}" >&2
    exit 64
    ;;
esac
