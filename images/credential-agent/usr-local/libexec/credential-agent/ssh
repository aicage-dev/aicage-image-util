#!/bin/sh
set -eu

socket="${SSH_AUTH_SOCK:-/run/credential-agent/ssh-agent.sock}"

case "${1:-}" in
  serve)
    rm -f "$socket"
    exec ssh-agent -D -a "$socket"
    ;;
  ready)
    if SSH_AUTH_SOCK="$socket" ssh-add -l >/dev/null 2>&1; then
      exit 0
    else
      [ "$?" -eq 1 ]
    fi
    ;;
  list)
    if identities="$(SSH_AUTH_SOCK="$socket" ssh-add -L)"; then
      printf '%s\n' "$identities"
    else
      [ "$?" -eq 1 ]
    fi
    ;;
  load)
    key_path="${2:?Usage: credential-agent ssh load KEY_PATH}"
    key_copy="$(mktemp)"
    trap 'rm -f "$key_copy"' EXIT HUP INT TERM
    cp "$key_path" "$key_copy"
    chmod 600 "$key_copy"
    SSH_AUTH_SOCK="$socket" \
      SSH_ASKPASS=/usr/local/libexec/credential-agent/ssh-askpass \
      SSH_ASKPASS_REQUIRE=force \
      DISPLAY=dummy \
      ssh-add "$key_copy"
    ;;
  load-interactive)
    key_path="${2:?Usage: credential-agent ssh load-interactive KEY_PATH}"
    key_copy="$(mktemp)"
    trap 'rm -f "$key_copy"' EXIT HUP INT TERM
    cp "$key_path" "$key_copy"
    chmod 600 "$key_copy"
    SSH_AUTH_SOCK="$socket" ssh-add "$key_copy"
    ;;
  remove)
    key_copy="$(mktemp)"
    trap 'rm -f "$key_copy"' EXIT HUP INT TERM
    IFS= read -r public_key
    test -n "$public_key"
    printf '%s\n' "$public_key" > "$key_copy"
    SSH_AUTH_SOCK="$socket" ssh-add -d "$key_copy"
    ;;
  *)
    echo "Usage: credential-agent ssh {list|load KEY_PATH|load-interactive KEY_PATH|remove|ready|serve}" >&2
    exit 64
    ;;
esac
