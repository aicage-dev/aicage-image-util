#!/bin/sh
set -eu

case "${1:-}" in
  ssh)
    shift
    exec /usr/local/libexec/aicage-credential-agent/ssh "$@"
    ;;
  gpg)
    shift
    exec /usr/local/libexec/aicage-credential-agent/gpg "$@"
    ;;
  *)
    echo "Usage: aicage-credential-agent {ssh|gpg} {load|ready|serve}" >&2
    exit 64
    ;;
esac
