#!/bin/sh
set -eu

log_path="${AICAGE_CREDENTIAL_AGENT_LOG_PATH:-/tmp/aicage-credential-agent.log}"

case "${1:-}" in
  ssh)
    shift
    handler=/usr/local/libexec/aicage-credential-agent/ssh
    ;;
  gpg)
    shift
    handler=/usr/local/libexec/aicage-credential-agent/gpg
    ;;
  *)
    echo "Usage: aicage-credential-agent {ssh|gpg} {load|ready|serve}" >&2
    exit 64
    ;;
esac

mkdir -p "$(dirname "$log_path")"
{
  printf '%s %s' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1"
  for argument in "$@"; do
    printf ' %s' "$argument"
  done
  printf '\n'
  if "$handler" "$@"; then
    printf '%s exit=0\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  else
    status=$?
    printf '%s exit=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$status"
    exit "$status"
  fi
} >>"$log_path" 2>&1
