#!/bin/sh
set -eu

socket_directory="${CREDENTIAL_AGENT_SOCKET_DIRECTORY:-/run/credential-agent}"
uid="${AICAGE_UID:-0}"
gid="${AICAGE_GID:-0}"

if [ "${2:-}" = "serve" ]; then
  mkdir -p "$socket_directory"
  chown "$uid:$gid" "$socket_directory"
  chmod 700 "$socket_directory"
  exec su-exec "$uid:$gid" credential-agent "$@"
fi

exec credential-agent "$@"
