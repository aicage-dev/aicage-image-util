#!/bin/sh
set -eu

socket_dir="${AICAGE_GPG_SOCKET_DIR:-/run/aicage-credential-agent}"
gpg_home="${GNUPGHOME:-/credential/gnupg}"
socket="$socket_dir/S.gpg-agent"

case "${1:-}" in
  serve)
    rm -f "$socket"
    gpg-agent --daemon --homedir "$gpg_home" --extra-socket "$socket"
    exec tail -f /dev/null
    ;;
  ready)
    gpg-connect-agent --raw-socket "$socket" /bye >/dev/null
    ;;
  *)
    echo "Usage: aicage-credential-agent gpg {ready|serve}" >&2
    exit 64
    ;;
esac
